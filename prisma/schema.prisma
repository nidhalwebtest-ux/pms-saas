// 1. Config
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 2. Enums
enum UserRole {
  OWNER        // Org creator — full access, cannot be removed
  MANAGER      // Admin — full operational access, can manage team
  STAFF        // Receptionist — tenants & reservations only
  ACCOUNTANT   // Accountant — payments & expenses only
}

enum PropertyType {
  RESIDENTIAL
  MIXED
  HOTEL
  COMMERCIAL
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationActivityAction {
  CREATED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  PAYMENT_RECORDED
  CHARGE_ADDED
  UNIT_CHANGED
  DATES_CHANGED
  EXTENDED
  UNIT_MOVED
  NOTE_ADDED
  RETURN_PROCESSED
  REFUND_PROCESSED
  CONTRACT_SIGNED
}

enum ReturnType {
  DAILY
  MONTHLY
}

enum RefundStatus {
  NOT_REQUIRED
  PENDING
  COMPLETED
}

enum PaymentFrequency {
  DAILY
  MONTHLY
  YEARLY
}

// Invoice status
enum InvoiceStatus {
  // ── Active statuses ───────────────────────────────────────────────
  PENDING        // created, no payment received yet
  PARTIALLY_PAID // some payment received, balance remaining
  PAID           // fully paid, balance_due = 0
  RETURNED       // payment returned/refunded to tenant
  CANCELLED      // voided — excluded from all financial calculations
  // ── Legacy values (kept so PostgreSQL doesn't error on old rows) ──
  PARTIAL        // migrated → PARTIALLY_PAID
  DUE            // migrated → PENDING
  VOID           // migrated → CANCELLED
  DRAFT          // migrated → PENDING
  ISSUED         // migrated → PENDING
}

enum InvoiceType {
  SHORT_TERM    // single invoice for daily stays ≤30 nights
  MONTHLY       // one of many monthly invoices for long stays
  OVERSTAY      // extra days beyond checkout date
  ADDITIONAL    // ad-hoc extra charges
}

enum LineItemCategory {
  ROOM_CHARGE
  EXTRA_CHARGE
  CLEANING
  DAMAGE
  SERVICE
  OVERSTAY
  ADJUSTMENT
  OTHER
}

enum RateType {
  DAILY
  MONTHLY
}

enum RateSource {
  DEFAULT_PRICE
  SEASONAL_PRICE
  MANUAL_OVERRIDE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  ONLINE
  OTHER
}

enum ExpenseCategory {
  UTILITIES      // Water, Electricity, Internet
  MAINTENANCE    // Spare parts, labor
  SALARY         // Staff cost
  MARKETING      // Ads
  SUPPLIES       // Cleaning stuff
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

// 3. Organization
model Organization {
  id                 String   @id @default(uuid())
  name               String

  phone              String?
  address            String?
  city               String   @default("Salalah")
  area               String?
  logo               String?
  timezone           String   @default("Asia/Muscat")
  currency           String   @default("OMR")

  /// PDF/document customization (Settings → Organization). Applied to every
  /// generated PDF (reservation, invoice, receipt, return, expense, statement).
  /// pdfBrandColor drives each document's header + primary accent (via --brand);
  /// status colours stay semantic. Footer text overrides the default footer line.
  pdfBrandColor         String  @default("#185FA5")
  pdfFooterText         String?
  pdfFooterTextAr       String?
  pdfPaperSize          String  @default("A4")   // A4 | Letter
  pdfShowLogo           Boolean @default(true)
  pdfShowSignature      Boolean @default(true)   // reservation signature block
  pdfShowPaymentHistory Boolean @default(true)   // invoice + receipt payment tables
  pdfShowNotes          Boolean @default(true)   // notes sections

  /// Org-wide default check-in policy; reservations may override per-booking.
  checkInPolicy      CheckInPolicy @default(ALLOW_BACK_TO_BACK)
  /// When false, units with only upcoming (CONFIRMED/PENDING) reservations show
  /// as "Vacant" instead of "Reserved". Toggled in Settings → Units.
  showReservedStatus Boolean  @default(false)
  /// When false, a guest cannot be checked in before their reservation start date.
  allowEarlyCheckIn  Boolean  @default(true)
  /// When true, reservations past their end date are checked out automatically
  /// (by a scheduled job). When false, staff check out manually.
  autoCheckout       Boolean  @default(false)

  /// Reservation-number format (Settings → Reservations). Number =
  /// `${prefix}-${year}-${seq}` when reservationNumberResetYearly is true (seq
  /// restarts each year), else `${prefix}-${seq}` continuous. `seq` is zero-padded
  /// to reservationNumberPadding. See generateReservationNumber in the API route.
  reservationNumberPrefix      String  @default("RES")
  reservationNumberPadding     Int     @default(5)
  reservationNumberResetYearly Boolean @default(true)

  /// Invoice Settings (Settings → Reservations — QA #43). In this product the
  /// "contract" IS the invoice. Per-rate-type generation timing and an auto-issue
  /// policy drive when invoices are created and posted:
  ///   *InvoiceTiming:    ON_CREATE | ON_CHECK_IN | MANUAL
  ///   autoIssueOnCheckIn: ALL_STARTED | FIRST_ONLY | NONE
  ///   requireInvoiceForCheckIn: OFF | DAILY | MONTHLY | BOTH
  /// Invoices generated while the reservation is NOT checked in are DRAFT
  /// (provisional); check-in issues them per autoIssueOnCheckIn.
  dailyInvoiceTiming       String @default("MANUAL")
  monthlyInvoiceTiming     String @default("MANUAL")
  autoIssueOnCheckIn       String @default("ALL_STARTED")
  requireInvoiceForCheckIn String @default("OFF")

  /// Payment Settings (Settings → Payments — QA #46). How a payment exceeding the
  /// outstanding balance is handled: BLOCK (reject), WARN (confirm then allow as
  /// credit), ALLOW (silent credit).
  overpaymentPolicy        String @default("WARN")

  /// Return Settings (Settings → Returns). Returns are credit-note transactions that
  /// never change an invoice's total/line items.
  ///   returnDraftPolicy:   CANCEL (cancel unissued future DRAFT cycles) | CREDIT (keep + credit)
  ///   returnBalancePolicy: NET (headline balance shows net of credits) | GROSS (show gross total + credit line)
  ///   returnRateBasis:     CHARGED (rate the guest was charged, from pricingSegments) | PRICE_LIST (current price list)
  returnDraftPolicy        String @default("CANCEL")
  returnBalancePolicy      String @default("NET")
  returnRateBasis          String @default("CHARGED")

  plan               String   @default("FREE")
  maxProperties      Int      @default(1)
  subscriptionStatus String   @default("ACTIVE")

  createdAt          DateTime @default(now())

  users              User[]
  roles              Role[]
  properties         Property[]
  tenants            Tenant[]
  invitations        Invitation[]
  invoices           Invoice[]
  expenseCategories  ExpenseCat[]
  expenses           Expense[]
  reservations       Reservation[]
  bankAccounts       BankAccount[]
  cashierSessions    CashierSession[]
}

// 4. Users
enum Language {
  en
  ar
}

/// Controls whether a unit must be fully vacated before a new guest can be
/// checked in, or whether same-day (back-to-back) turnover is allowed.
enum CheckInPolicy {
  /// Allow back-to-back check-in: only true DATE overlaps block a check-in.
  /// A new guest may be checked in on the prior guest's checkout day even if
  /// the prior reservation has not yet been checked out. (default)
  ALLOW_BACK_TO_BACK
  /// Require the unit to be vacant: block check-in if any other reservation on
  /// the unit is still CHECKED_IN (not yet checked out), in addition to any
  /// date overlap. Forces a clean turnover.
  REQUIRE_VACANT
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  firstName      String?
  lastName       String?
  phone          String?
  role           UserRole     @default(OWNER)
  preferredLanguage Language  @default(en)

  // Custom RBAC role (NetSuite-style permission matrix). Nullable during rollout;
  // when set it governs access, otherwise the legacy `role` enum is the fallback.
  roleId         String?
  assignedRole   Role?        @relation("UserAssignedRole", fields: [roleId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  assignedProperties  PropertyAssignment[]
  sentInvitations     Invitation[]          @relation("SentInvitations")
  unitNotes           UnitNote[]
  createdTenants      Tenant[]              @relation("TenantCreatedBy")
  createdReservations Reservation[]         @relation("ReservationCreatedBy")
  performedActivities ReservationActivity[] @relation("ActivityPerformedBy")
  createdCharges      ReservationCharge[]   @relation("ChargeCreatedBy")
  createdInvoices               Invoice[]       @relation("InvoiceCreatedBy")
  receivedPayments              Payment[]       @relation("PaymentReceivedBy")
  invoicesGeneratedReservations Reservation[]  @relation("InvoicesGeneratedBy")
  createdReturns                Return[]        @relation("ReturnCreatedBy")
  processedRefunds              Return[]        @relation("ReturnRefundProcessedBy")
  submittedExpenses             Expense[]       @relation("ExpenseSubmittedBy")
  reviewedExpenses              Expense[]       @relation("ExpenseReviewedBy")
  processedExpenses             Expense[]       @relation("ExpenseProcessedBy")
  cashierSessions               CashierSession[] @relation("CashierSessions")

  createdAt      DateTime     @default(now())
}

// 5. Property Assignments
model PropertyAssignment {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

// 6. Properties
model Property {
  id             String       @id @default(uuid())
  name           String
  type           PropertyType @default(RESIDENTIAL)

  isActive       Boolean      @default(true)
  isArchived     Boolean      @default(false)
  archivedAt     DateTime?
  photos         String[]     @default([])

  totalFloors    Int?
  description    String?

  address        String?
  city           String       @default("Salalah")
  governorate    String       @default("Dhofar")

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  units          Unit[]
  assignments    PropertyAssignment[]
  expenses       Expense[]
  invoices       Invoice[]
  cashierSessions CashierSession[]

  createdAt      DateTime @default(now())
}

model Unit {
  id          String   @id @default(uuid())
  name        String
  unitType    String   @default("ONE_BR")
  floor       Int      @default(0)
  bedrooms    Int      @default(1)
  bathrooms   Int      @default(1)
  area        Float?
  description String?
  amenities   String[] @default([])

  basePrice   Decimal    @db.Decimal(10, 3)
  status      UnitStatus @default(AVAILABLE)
  photos      String[]   @default([])

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  reservations     Reservation[]
  reservationUnits ReservationUnit[]  @relation("ReservationUnitToUnit")
  prices           UnitPrice[]
  notes            UnitNote[]
  lineItems        InvoiceLineItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UnitPrice {
  id          String   @id @default(uuid())

  priceType   String   @default("DEFAULT")
  name        String?

  dailyRate   Decimal  @db.Decimal(10, 3)
  weeklyRate  Decimal? @db.Decimal(10, 3)
  monthlyRate Decimal  @db.Decimal(10, 3)

  startDate   DateTime?
  endDate     DateTime?

  priority    Int      @default(10)
  isActive    Boolean  @default(true)

  /// SEASONAL only — when true, monthly-rate reservations whose dates overlap
  /// this season are blocked (e.g. maximize short-term Khareef bookings). QA #27.
  disallowMonthly Boolean @default(false)

  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UnitNote {
  id        String   @id @default(uuid())
  content   String

  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Tenant {
  id             String   @id @default(uuid())

  firstName          String
  lastName           String
  fullNameArabic     String?
  gender             String?
  dateOfBirth        DateTime?
  nationality        String?

  nationalId         String?
  idType             String?  @default("national_id")
  idNumber           String?
  idExpiryDate       DateTime?
  idDocumentFront    String?
  idDocumentBack     String?

  email              String?
  phone              String
  phoneSecondary     String?
  whatsappNumber     String?

  country            String?
  city               String?
  addressLine        String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  tenantType         String   @default("individual")
  source             String   @default("walk_in")
  classification     String   @default("regular")
  corporateName      String?
  corporateContact   String?

  preferredFloor         String?
  preferredUnitType      String?
  preferredPaymentMethod String?
  specialRequests        String?
  internalNotes          String?
  tags                   String[] @default([])

  isActive       Boolean   @default(true)
  totalStays     Int       @default(0)
  totalSpent     Decimal   @default(0) @db.Decimal(10, 3)
  firstStayDate  DateTime?
  lastStayDate   DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById    String?
  createdBy      User?    @relation("TenantCreatedBy", fields: [createdById], references: [id])

  reservations   Reservation[]
  payments       Payment[]
  invoices       Invoice[]
  returns        Return[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Reservation {
  id                String   @id @default(uuid())
  reservationNumber String?

  // Denormalized org id (mirrors Tenant.organizationId) so reservation numbers
  // can be sequenced and uniquely constrained per organization. See @@unique below.
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  startDate         DateTime
  endDate           DateTime
  actualCheckIn     DateTime?
  actualCheckOut    DateTime?

  status            ReservationStatus @default(PENDING)
  frequency         PaymentFrequency  @default(MONTHLY)

  totalNights       Int      @default(0)
  amount            Decimal  @db.Decimal(10, 3)
  totalAmount       Decimal  @default(0) @db.Decimal(10, 3)
  discountAmount    Decimal  @default(0) @db.Decimal(10, 3)
  taxAmount         Decimal  @default(0) @db.Decimal(10, 3)
  grandTotal        Decimal  @default(0) @db.Decimal(10, 3)
  amountPaid        Decimal  @default(0) @db.Decimal(10, 3)
  totalPrice        Float    @default(0)

  rateType          String   @default("daily")
  source            String   @default("walk_in")
  notes             String?
  cancelledReason   String?
  cancelledAt       DateTime?
  refundPending     Boolean  @default(false)

  // Per-reservation check-in policy override. NULL = inherit the organization's
  // default (Organization.checkInPolicy).
  checkInPolicyOverride CheckInPolicy?

  // Expected total number of monthly invoices (set at creation for monthly stays)
  expectedInvoiceCount Int?

  // Invoice generation tracking
  invoicesGenerated     Boolean   @default(false)
  invoicesGeneratedAt   DateTime?
  invoicesGeneratedById String?
  invoicesGeneratedBy   User?     @relation("InvoicesGeneratedBy", fields: [invoicesGeneratedById], references: [id])

  unitId            String?
  unit              Unit?    @relation(fields: [unitId], references: [id])

  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  reservationUnits  ReservationUnit[]
  payments          Payment[]
  invoices          Invoice[]
  activities        ReservationActivity[]
  charges           ReservationCharge[]
  returns           Return[]

  createdById       String?
  createdBy         User?    @relation("ReservationCreatedBy", fields: [createdById], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Per-org sequential reservation numbers (e.g. RES-2026-00001). NULLs allowed
  // (legacy/unsaved); Postgres treats NULLs as distinct so the constraint only
  // bites real numbers within an org.
  @@unique([organizationId, reservationNumber])
  @@index([organizationId, createdAt])
}

model ReservationUnit {
  id                  String   @id @default(uuid())

  reservationId       String
  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  unitId              String
  unit                Unit        @relation("ReservationUnitToUnit", fields: [unitId], references: [id])

  rateType            String   @default("daily")
  rateAmount          Decimal  @db.Decimal(10, 3)
  rateSource          String   @default("default_price")
  seasonalPriceName   String?

  // Snapshot of the per-night/per-month price breakdown computed at booking time.
  // Shape: [{ startDate, endDate, nights, rateAmount, rateSource, priceName }].
  // rateAmount above stays the FIRST segment's rate for back-compat; this column
  // is the source of truth for stays that span >1 price segment (e.g. Khareef).
  pricingSegments     Json?

  nights              Int      @default(0)
  subtotal            Decimal  @db.Decimal(10, 3)

  effectiveCheckIn    DateTime?
  effectiveCheckOut   DateTime?
  isMovedOut          Boolean  @default(false)
  movedToUnitId       String?
  moveReason          String?
  moveDate            DateTime?

  createdAt           DateTime @default(now())
}

model ReservationActivity {
  id             String                    @id @default(uuid())
  reservationId  String
  reservation    Reservation               @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  organizationId String
  action         ReservationActivityAction
  description    String
  performedById  String?
  performedBy    User?                     @relation("ActivityPerformedBy", fields: [performedById], references: [id])
  metadata       Json?
  createdAt      DateTime                  @default(now())

  @@index([reservationId])
  @@index([organizationId, createdAt])
}

model ReservationCharge {
  id             String      @id @default(uuid())
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  organizationId String
  description    String
  amount         Decimal     @db.Decimal(10, 3)
  category       String      @default("other")
  createdById    String?
  createdBy      User?       @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
}

// ── Invoice System ────────────────────────────────────────────────────────────

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Sequential number per org: "INV-2026-00001"
  invoiceNumber   String

  reservationId   String
  reservation     Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])

  // Optional link to a specific property/building
  propertyId      String?
  property        Property?     @relation(fields: [propertyId], references: [id])

  // Period this invoice covers
  periodStart     DateTime
  periodEnd       DateTime
  invoiceType     InvoiceType   @default(SHORT_TERM)
  monthNumber     Int?          // 1, 2, 3… for MONTHLY invoices

  // Amounts — all OMR (3 decimal places)
  subtotal        Decimal       @db.Decimal(10, 3)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 3)
  taxAmount       Decimal       @default(0) @db.Decimal(10, 3)
  totalAmount     Decimal       @db.Decimal(10, 3)
  amountPaid      Decimal       @default(0) @db.Decimal(10, 3)
  // Running sum of return credits applied to this invoice (credit-note model).
  // totalAmount + line items are frozen; balanceDue = totalAmount - amountPaid - creditedAmount.
  creditedAmount  Decimal       @default(0) @db.Decimal(10, 3)
  balanceDue      Decimal       @db.Decimal(10, 3)

  status          InvoiceStatus @default(DRAFT)

  issueDate       DateTime      @default(now())
  dueDate         DateTime
  paidDate        DateTime?
  cancelledAt     DateTime?
  cancelledReason String?

  notes           String?

  createdById     String?
  createdBy       User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  lineItems       InvoiceLineItem[]
  payments        Payment[]         // legacy direct link kept for compat
  allocations     PaymentAllocation[]
  returns         Return[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([tenantId])
  @@index([reservationId])
}

model InvoiceLineItem {
  id              String           @id @default(uuid())

  invoiceId       String
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  organizationId  String

  description     String
  category        LineItemCategory @default(ROOM_CHARGE)

  unitId          String?
  unit            Unit?            @relation(fields: [unitId], references: [id])

  // quantity × unitPrice = lineTotal
  quantity        Decimal          @db.Decimal(10, 3)
  unitPrice       Decimal          @db.Decimal(10, 3)
  lineTotal       Decimal          @db.Decimal(10, 3)

  rateType        RateType?
  rateSource      RateSource?
  seasonalPriceName String?

  // JSON array of price segments when rates vary: [{days, rate, label, subtotal}]
  priceBreakdown  Json?

  sortOrder       Int              @default(0)

  createdAt       DateTime @default(now())
}

// ── Payments ──────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(uuid())

  // Sequential number per org: "PAY-2026-00001" — null for legacy records
  paymentNumber   String?
  organizationId  String?

  amount          Decimal       @db.Decimal(10, 3)
  date            DateTime      @default(now())
  method          PaymentMethod @default(CASH)
  reference       String?
  notes           String?
  isRefund        Boolean       @default(false)

  // Which bank account a non-cash payment settles into (transfer/card/cheque/
  // online). Null for cash. Drives the bank statement + matching (later phases).
  bankAccountId   String?
  bankAccount     BankAccount?  @relation(fields: [bankAccountId], references: [id])

  // Which staff member received/logged this payment
  receivedById    String?
  receivedBy      User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])

  reservationId   String?
  reservation     Reservation?  @relation(fields: [reservationId], references: [id])

  // Legacy: direct link to one invoice (kept for backward compat)
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])

  // New: allocation records (one payment → many invoices)
  allocations     PaymentAllocation[]

  // Bank ledger row mirroring this payment (when it routes to a bank).
  bankTransaction BankTransaction?

  createdAt       DateTime @default(now())
}

model PaymentAllocation {
  id             String   @id @default(uuid())

  paymentId      String
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  organizationId String

  // Amount of this payment applied to this invoice
  amount         Decimal  @db.Decimal(10, 3)

  createdAt      DateTime @default(now())

  @@unique([paymentId, invoiceId])
}

// ── Returns ───────────────────────────────────────────────────────────────────

model Return {
  id             String       @id @default(uuid())
  returnNumber   String

  organizationId String

  reservationId  String
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  invoiceId      String?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])

  // Return period
  returnFrom     DateTime
  returnTo       DateTime
  returnDays     Int          @default(0)
  returnType     ReturnType   @default(DAILY)

  // Amounts
  returnAmount   Decimal      @db.Decimal(10, 3)

  // Refund
  refundRequired Boolean      @default(false)
  refundAmount   Decimal      @default(0) @db.Decimal(10, 3)
  refundStatus   RefundStatus @default(NOT_REQUIRED)
  refundMethod   String?
  refundReference String?
  refundDate     DateTime?
  refundProcessedById String?
  refundProcessedBy   User?   @relation("ReturnRefundProcessedBy", fields: [refundProcessedById], references: [id])

  // Meta
  reason         String
  notes          String?
  status         String       @default("active")  // "active" | "cancelled"

  createdById    String?
  createdBy      User?        @relation("ReturnCreatedBy", fields: [createdById], references: [id])

  lineItems      ReturnLineItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, returnNumber])
  @@index([reservationId])
  @@index([tenantId])
}

model ReturnLineItem {
  id             String   @id @default(uuid())

  returnId       String
  return         Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  organizationId String

  unitId         String?

  description    String
  quantity       Decimal  @db.Decimal(10, 3)
  unitPrice      Decimal  @db.Decimal(10, 3)
  lineTotal      Decimal  @db.Decimal(10, 3)

  createdAt      DateTime @default(now())
}

// ── Expense Categories ────────────────────────────────────────────────────────

model ExpenseCat {
  id             String       @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  nameAr         String?
  icon           String?       // emoji e.g. "🧹"
  isSystem       Boolean       @default(false)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)

  expenses       Expense[]

  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

// ── Bank accounts ─────────────────────────────────────────────────────────────
/// A company bank account (e.g. "Bank Muscat — Main"). Non-cash payments
/// (transfer/card/cheque/online) route to one of these; the bank statement +
/// matching (later phases) build a ledger per account. Org-level, not per-building.
model BankAccount {
  id             String       @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bankName       String       // "Bank Muscat", "Bank Dhofar"
  label          String?      // optional: branch / "Main operating account"
  accountNumber  String?      // may be partial/masked
  currency       String       @default("OMR")
  openingBalance Decimal      @default(0) @db.Decimal(12, 3)
  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)
  sortOrder      Int          @default(0)

  payments       Payment[]
  expenses       Expense[]
  transactions   BankTransaction[]
  statementLines BankStatementLine[]
  cashierDeposits CashierSession[] @relation("CashierDeposits")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

/// Signed ledger of everything that hits a bank account. One row per event:
/// payments in, refunds out, cash deposits in, expenses out, manual adjustments.
/// `amount` is signed (+ inflow, − outflow); running balance = openingBalance + Σ.
/// Backs the Bank Statement and (Phase 5) bank matching.
enum BankTxnType {
  PAYMENT_IN
  REFUND_OUT
  DEPOSIT_IN
  EXPENSE_OUT
  ADJUSTMENT
  FEE
}

model BankTransaction {
  id             String       @id @default(uuid())

  organizationId String
  bankAccountId  String
  bankAccount    BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  type           BankTxnType
  amount         Decimal      @db.Decimal(12, 3) // signed: + inflow, − outflow
  date           DateTime
  description    String?
  reference      String?

  // Provenance — at most one source link; null source = manual adjustment/fee.
  paymentId      String?      @unique
  payment        Payment?     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expenseId      String?      @unique
  expense        Expense?     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  cashierSessionId String?    // DEPOSIT_IN rows from a cashier reconciliation

  // Bank matching (Phase 5): the imported statement line this book row matches.
  matchedLine    BankStatementLine? @relation("LineMatch")

  isVoid         Boolean      @default(false)
  createdById    String?

  createdAt      DateTime     @default(now())

  @@index([bankAccountId, date])
  @@index([organizationId])
}

// ── Bank matching ─────────────────────────────────────────────────────────────
/// A line from the bank's real statement (CSV import or manual entry), matched
/// 1:1 against a book BankTransaction during reconciliation.
enum BankLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model BankStatementLine {
  id             String         @id @default(uuid())

  organizationId String
  bankAccountId  String
  bankAccount    BankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  date           DateTime
  description    String?
  reference      String?
  amount         Decimal        @db.Decimal(12, 3) // signed: + credit, − debit

  importBatchId  String?
  status         BankLineStatus @default(UNMATCHED)

  matchedTxnId   String?        @unique
  matchedTxn     BankTransaction? @relation("LineMatch", fields: [matchedTxnId], references: [id], onDelete: SetNull)

  createdById    String?
  createdAt      DateTime       @default(now())

  @@index([bankAccountId, date])
  @@index([organizationId])
}

// ── Cashier (daily cash reconciliation) ───────────────────────────────────────
/// One end-of-day cash count: expected drawer cash (cash payments − cash
/// refunds for the day) vs counted cash → variance, then the cash is deposited
/// to a bank (posting a DEPOSIT_IN ledger row).
enum CashierSessionStatus {
  OPEN
  RECONCILED
  DEPOSITED
}

model CashierSession {
  id             String   @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  cashierId      String
  cashier        User         @relation("CashierSessions", fields: [cashierId], references: [id])

  businessDate   DateTime     // the day being reconciled

  systemCash     Decimal      @default(0) @db.Decimal(12, 3) // expected drawer cash
  countedCash    Decimal      @default(0) @db.Decimal(12, 3) // physically counted
  variance       Decimal      @default(0) @db.Decimal(12, 3) // counted − system

  status         CashierSessionStatus @default(RECONCILED)

  // Deposit of the cash into a bank account
  depositBankAccountId String?
  depositBankAccount   BankAccount? @relation("CashierDeposits", fields: [depositBankAccountId], references: [id])
  depositedAmount      Decimal?     @db.Decimal(12, 3)
  depositReference     String?
  depositedAt          DateTime?

  notes          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, businessDate])
}

// ── Expenses ──────────────────────────────────────────────────────────────────

model Expense {
  id             String          @id @default(uuid())

  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expenseNumber  String          // "EXP-2026-00001"

  // --- What ---
  categoryId     String
  category       ExpenseCat      @relation(fields: [categoryId], references: [id])
  description    String
  amount         Decimal         @db.Decimal(10, 3)

  // --- Where ---
  propertyId     String
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // --- Receipt ---
  receiptImage   String?         // file URL — optional for now (storage RLS rollout)
  receiptImage2  String?         // second receipt image

  // --- Workflow ---
  status         ExpenseStatus   @default(PENDING)

  // Submission
  submittedById  String
  submittedBy    User            @relation("ExpenseSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime        @default(now())

  // Approval / Rejection
  reviewedById   String?
  reviewedBy     User?           @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  rejectionReason String?

  // Processing (accountant)
  processedById  String?
  processedBy    User?           @relation("ExpenseProcessedBy", fields: [processedById], references: [id])
  processedAt    DateTime?
  paymentMethod  String?         // "petty_cash" | "bank_transfer" | "already_paid"
  bankReference  String?
  processingNotes String?

  // Which bank account an expense was paid from (when paymentMethod routes to a
  // bank). Produces an EXPENSE_OUT bank ledger row at processing time.
  bankAccountId  String?
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id])
  bankTransaction BankTransaction?

  // Meta
  notes          String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, expenseNumber])
  @@index([organizationId, status])
  @@index([submittedById])
  @@index([propertyId])
}

// ── Auth & Team ───────────────────────────────────────────────────────────────

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Invitation {
  id             String    @id @default(uuid())
  email          String
  role           UserRole
  token          String    @unique @default(uuid())
  expiresAt      DateTime
  usedAt         DateTime?
  cancelledAt    DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById    String
  invitedBy      User         @relation("SentInvitations", fields: [invitedById], references: [id])

  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([email, organizationId])
}

/// Manager-set sales targets, compared against actual sales in the Sales
/// Forecast (target-vs-actual) report. Polymorphic by `scope`: refId points to
/// a User (receptionist), Property (building) or Unit. One target per
/// (org, scope, refId, periodType, periodStart). periodStart is normalized UTC:
/// the 1st of the month (MONTHLY) or the Monday of the week (WEEKLY).
model SalesTarget {
  id             String   @id @default(uuid())
  organizationId String

  scope          String   // RECEPTIONIST | BUILDING | UNIT
  refId          String   // userId | propertyId | unitId (per scope)

  periodType     String   // WEEKLY | MONTHLY
  periodStart    DateTime

  amount         Decimal  @db.Decimal(10, 3)

  createdById    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, scope, refId, periodType, periodStart])
  @@index([organizationId, scope, periodType, periodStart])
}

/// NetSuite-style RBAC role. `permissions` is a JSON map of entityKey → level
/// ("NONE"|"VIEW"|"CREATE"|"EDIT"|"FULL"); entity catalog + defaults live in
/// lib/rbac.ts. System roles (isSystem=true, stable `key` OWNER/MANAGER/STAFF/
/// ACCOUNTANT) are seeded per org and read-only — duplicate ("Save as") to a
/// custom role to edit. Users link via User.roleId (legacy User.role enum is the
/// fallback until enforcement rolls out).
model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  key            String?      // OWNER | MANAGER | STAFF | ACCOUNTANT for system roles; null for custom
  isSystem       Boolean      @default(false)
  description    String?

  permissions    Json         @default("{}")

  createdById    String?

  users          User[]       @relation("UserAssignedRole")

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}
