// 1. Config
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 2. Enums
enum UserRole {
  OWNER        // Org creator — full access, cannot be removed
  MANAGER      // Admin — full operational access, can manage team
  STAFF        // Receptionist — tenants & reservations only
  ACCOUNTANT   // Accountant — payments & expenses only
}

enum PropertyType {
  RESIDENTIAL
  MIXED
  HOTEL
  COMMERCIAL
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationActivityAction {
  CREATED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  PAYMENT_RECORDED
  CHARGE_ADDED
  UNIT_CHANGED
  DATES_CHANGED
  EXTENDED
  UNIT_MOVED
  NOTE_ADDED
}

// 3. The New Powerhouse: Organization
model Organization {
  id                 String   @id @default(uuid())
  name               String   // e.g. "Salalah Real Estate Co."

  // Company details (set during onboarding)
  phone              String?
  address            String?
  city               String   @default("Salalah")
  area               String?
  logo               String?  // URL from Supabase Storage
  timezone           String   @default("Asia/Muscat")
  currency           String   @default("OMR")

  // Subscription / Limits Logic
  plan               String   @default("FREE") // FREE, STARTER, PRO
  maxProperties      Int      @default(1)
  subscriptionStatus String   @default("ACTIVE") // ACTIVE, PAST_DUE

  createdAt          DateTime @default(now())

  // Everything belongs to the Org
  users              User[]
  properties         Property[]
  tenants            Tenant[]
  invitations        Invitation[]
}

// 4. Users (Staff Members)
model User {
  id             String       @id @default(uuid())
  email          String       @unique
  firstName      String?
  lastName       String?
  phone          String?
  role           UserRole     @default(OWNER)

  // Link to Organization
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Access Control: Which properties can this user see?
  assignedProperties  PropertyAssignment[]
  sentInvitations     Invitation[]         @relation("SentInvitations")
  unitNotes           UnitNote[]
  createdTenants      Tenant[]             @relation("TenantCreatedBy")
  createdReservations Reservation[]        @relation("ReservationCreatedBy")
  performedActivities ReservationActivity[] @relation("ActivityPerformedBy")
  createdCharges      ReservationCharge[]   @relation("ChargeCreatedBy")

  createdAt      DateTime     @default(now())
}

// 5. Explicit Assignments (For Receptionists)
model PropertyAssignment {
  id          String   @id @default(uuid())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId]) // Prevent duplicate assignments
}

// 6. Properties
model Property {
  id             String   @id @default(uuid())
  name           String
  type           PropertyType @default(RESIDENTIAL)
  
  // Status & Media
  isActive       Boolean      @default(true)
  isArchived     Boolean      @default(false)
  archivedAt     DateTime?
  photos         String[]     @default([])

  // Details
  totalFloors    Int?
  description    String?

  // Location
  address        String?
  city           String       @default("Salalah")
  governorate    String       @default("Dhofar")

  // Link to Org
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Relations
  units          Unit[]
  assignments    PropertyAssignment[] // Who works here?
  expenses       Expense[]
  
  createdAt      DateTime @default(now())
}

// ... (Unit, Tenant, Reservation models remain mostly the same, 
// just ensure Tenant links to OrganizationId if you want shared tenants)

model Unit {
  id          String   @id @default(uuid())
  name        String   // e.g. "Room 101"
  unitType    String   @default("ONE_BR") // STUDIO | ONE_BR | TWO_BR | THREE_BR | SUITE
  floor       Int      @default(0)
  bedrooms    Int      @default(1)
  bathrooms   Int      @default(1)
  area        Float?   // sqm
  description String?
  amenities   String[] @default([]) // AC | FURNISHED | KITCHEN | PARKING | WIFI | TV | BALCONY | POOL

  basePrice   Decimal    @db.Decimal(10, 3)
  status      UnitStatus @default(AVAILABLE)
  photos      String[]   @default([])

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  reservations     Reservation[]       // legacy: direct FK via Reservation.unitId
  reservationUnits ReservationUnit[]   @relation("ReservationUnitToUnit")
  prices           UnitPrice[]
  notes            UnitNote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Unit Pricing ───────────────────────────────────────────────────────────────

model UnitPrice {
  id          String   @id @default(uuid())

  priceType   String   @default("DEFAULT") // "DEFAULT" | "SEASONAL"
  name        String?  // required for SEASONAL (e.g. "Khareef 2026")

  dailyRate   Decimal  @db.Decimal(10, 3)
  weeklyRate  Decimal? @db.Decimal(10, 3)
  monthlyRate Decimal  @db.Decimal(10, 3)

  // Only set for SEASONAL
  startDate   DateTime?
  endDate     DateTime?

  priority    Int      @default(10)  // higher wins when multiple seasonals overlap
  isActive    Boolean  @default(true)

  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Unit Notes ─────────────────────────────────────────────────────────────────

model UnitNote {
  id        String   @id @default(uuid())
  content   String

  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Tenant {
  id             String   @id @default(uuid())

  // ── Personal ────────────────────────────────────────────────────────────────
  firstName          String
  lastName           String
  fullNameArabic     String?           // for official documents
  gender             String?           // "male" | "female"
  dateOfBirth        DateTime?
  nationality        String?

  // ── Identification ──────────────────────────────────────────────────────────
  nationalId         String?           // kept for backward compat (legacy)
  idType             String?           @default("national_id")
  idNumber           String?           // primary id — unique per org enforced in code
  idExpiryDate       DateTime?
  idDocumentFront    String?           // Supabase Storage URL
  idDocumentBack     String?

  // ── Contact ─────────────────────────────────────────────────────────────────
  email              String?
  phone              String
  phoneSecondary     String?
  whatsappNumber     String?

  // ── Address ─────────────────────────────────────────────────────────────────
  country            String?
  city               String?
  addressLine        String?

  // ── Emergency Contact ───────────────────────────────────────────────────────
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // ── CRM Classification ──────────────────────────────────────────────────────
  tenantType         String   @default("individual")  // individual|family|corporate|government
  source             String   @default("walk_in")     // walk_in|phone|whatsapp|website|…
  classification     String   @default("regular")     // regular|vip|blacklisted
  corporateName      String?
  corporateContact   String?

  // ── Preferences & Notes ─────────────────────────────────────────────────────
  preferredFloor         String?
  preferredUnitType      String?
  preferredPaymentMethod String?
  specialRequests        String?
  internalNotes          String?
  tags                   String[]  @default([])

  // ── Status & CRM Stats ──────────────────────────────────────────────────────
  isActive       Boolean   @default(true)
  totalStays     Int       @default(0)
  totalSpent     Decimal   @default(0) @db.Decimal(10, 3)
  firstStayDate  DateTime?
  lastStayDate   DateTime?

  // ── Relations ───────────────────────────────────────────────────────────────
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById    String?
  createdBy      User?    @relation("TenantCreatedBy", fields: [createdById], references: [id])

  reservations   Reservation[]
  payments       Payment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


enum PaymentFrequency {
  DAILY
  MONTHLY
  YEARLY
}


model Reservation {
  id                String   @id @default(uuid())
  reservationNumber String?  @unique  // e.g. "RES-2026-00042"

  startDate         DateTime
  endDate           DateTime
  actualCheckIn     DateTime?
  actualCheckOut    DateTime?

  status            ReservationStatus @default(PENDING)
  frequency         PaymentFrequency  @default(MONTHLY) // keep for compat

  // ── Financial ──────────────────────────────────────────────────────────────
  totalNights       Int      @default(0)
  amount            Decimal  @db.Decimal(10, 3)          // kept for compat (= totalAmount)
  totalAmount       Decimal  @default(0) @db.Decimal(10, 3)
  discountAmount    Decimal  @default(0) @db.Decimal(10, 3)
  taxAmount         Decimal  @default(0) @db.Decimal(10, 3)
  grandTotal        Decimal  @default(0) @db.Decimal(10, 3)
  amountPaid        Decimal  @default(0) @db.Decimal(10, 3)
  totalPrice        Float    @default(0)                  // kept for compat

  // ── Rate & meta ────────────────────────────────────────────────────────────
  rateType          String   @default("daily")  // "daily" | "monthly"
  source            String   @default("walk_in")
  notes             String?
  cancelledReason   String?
  cancelledAt       DateTime?
  refundPending     Boolean   @default(false)

  // ── Relations ──────────────────────────────────────────────────────────────
  // Legacy single-unit FK (nullable — new reservations use reservationUnits)
  unitId            String?
  unit              Unit?    @relation(fields: [unitId], references: [id])

  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])

  reservationUnits  ReservationUnit[]

  payments          Payment[]
  invoices          Invoice[]
  activities        ReservationActivity[]
  charges           ReservationCharge[]

  createdById       String?
  createdBy         User?    @relation("ReservationCreatedBy", fields: [createdById], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ── Multi-unit junction table ─────────────────────────────────────────────────

model ReservationUnit {
  id                  String   @id @default(uuid())

  reservationId       String
  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  unitId              String
  unit                Unit        @relation("ReservationUnitToUnit", fields: [unitId], references: [id])

  rateType            String   @default("daily")  // "daily" | "monthly"
  rateAmount          Decimal  @db.Decimal(10, 3)
  rateSource          String   @default("default_price") // default_price|seasonal_price|manual_override
  seasonalPriceName   String?

  nights              Int      @default(0)
  subtotal            Decimal  @db.Decimal(10, 3)

  // ── Move / split-date tracking ─────────────────────────────────────────────
  effectiveCheckIn    DateTime?   // null = use reservation.startDate
  effectiveCheckOut   DateTime?   // null = use reservation.endDate; set when unit released early
  isMovedOut          Boolean   @default(false)   // true = this unit record was replaced by a move
  movedToUnitId       String?   // ReservationUnit.id of the replacement record
  moveReason          String?
  moveDate            DateTime?

  createdAt           DateTime @default(now())
}

model ReservationActivity {
  id             String                    @id @default(uuid())
  reservationId  String
  reservation    Reservation               @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  organizationId String
  action         ReservationActivityAction
  description    String
  performedById  String?
  performedBy    User?                     @relation("ActivityPerformedBy", fields: [performedById], references: [id])
  metadata       Json?
  createdAt      DateTime                  @default(now())

  @@index([reservationId])
  @@index([organizationId, createdAt])
}

model ReservationCharge {
  id             String      @id @default(uuid())
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  organizationId String
  description    String
  amount         Decimal     @db.Decimal(10, 3)
  category       String      @default("other")
  createdById    String?
  createdBy      User?       @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
}

enum InvoiceStatus {
  PENDING   // Future date
  PARTIAL   // Future date
  DUE       // Date passed, not paid
  PAID      // Money collected
  VOID      // Cancelled (Contract terminated)
}
model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   // e.g. "INV-2026-001"
  
  dueDate        DateTime 
  amount         Decimal  @db.Decimal(10, 2)
  status         InvoiceStatus @default(PENDING)
  description    String?  // e.g. "Rent for March 2026"

  // Relations
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  
  payments       Payment[] // One invoice can be paid in partial payments
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

model Payment {
  id            String   @id @default(uuid())
  amount        Decimal  @db.Decimal(10, 2)
  date          DateTime @default(now())
  method        PaymentMethod @default(CASH)
  reference     String?  // e.g. "Receipt #123" or "Transaction ID"
  notes         String?

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id]) 
  
  createdAt     DateTime @default(now())
}

model Expense {
  id             String   @id @default(uuid())
  title          String   // e.g. "Fix AC in Room 101"
  amount         Decimal  @db.Decimal(10, 2)
  date           DateTime @default(now())
  
  category       ExpenseCategory @default(MAINTENANCE)
  
  // Link to Property (Expenses are usually per property)
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  // Optional: Link to a specific Unit if needed
  unitId         String? 
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Tracks failed login attempts for rate-limiting (5 / 15 min lockout)
model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Team member invitations (72-hour expiry, email-based)
model Invitation {
  id             String    @id @default(uuid())
  email          String
  role           UserRole
  token          String    @unique @default(uuid())
  expiresAt      DateTime
  usedAt         DateTime?
  cancelledAt    DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById    String
  invitedBy      User         @relation("SentInvitations", fields: [invitedById], references: [id])

  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([email, organizationId])
}

enum ExpenseCategory {
  UTILITIES      // Water, Electricity, Internet
  MAINTENANCE    // Spare parts, labor
  SALARY         // Staff cost
  MARKETING      // Ads
  SUPPLIES       // Cleaning stuff
  OTHER
}